# Lingua server config — copy this file to .env and fill in real values

# ---- NVIDIA (default) ----
# Get a free API key: https://build.nvidia.com  -> any model -> Get API Key
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
# Default endpoint + model. Swap the model for any NVIDIA NIM you want.
# Primary should be FAST (free tier favors smaller models — bigger ones
# overload and time out). Verify ids with:  curl https://integrate.api.nvidia.com/v1/models
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Tried automatically when the primary times out or errors
NVIDIA_FALLBACK_MODEL=meta/llama-3.3-70b-instruct

# ---- Gemini (optional alternative) ----
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

PORT=4000